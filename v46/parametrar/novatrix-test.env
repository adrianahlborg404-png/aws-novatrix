# =============================================================
# En andra, fristaende kopia av hela miljon fran samma mallar.
# Visar att koden ar ateranvandbar: bara prefix och adressomrade
# skiljer. Bada miljoerna kan finnas samtidigt i kontot.
#   bash deploy.sh -p ../parametrar/novatrix-test.env <DIN-IP>
#   bash teardown.sh -p ../parametrar/novatrix-test.env
# =============================================================
PREFIX=novatrix-test
VPC_CIDR=10.1.0.0/16
INSTANSTYP=t3.micro
DB_KLASS=db.t3.micro
DB_LAGRING_GB=20
RDS_BACKUP_DAGAR=1
S3_BACKUP_DAGAR=14
