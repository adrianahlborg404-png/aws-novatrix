# =============================================================
# Parametrar for miljon "novatrix" (kursmiljon).
# Lases av deploy.sh, verify.sh, andring.sh och teardown.sh.
# Allt som skiljer en miljo fran en annan star har, inte i mallarna.
# =============================================================
PREFIX=novatrix           # namn pa stackar, resurser och exports
VPC_CIDR=10.0.0.0/16      # subnaten raknas ut fran detta (/24-block 1, 2, 11, 12)
INSTANSTYP=t3.micro       # webbserver och bastion
DB_KLASS=db.t3.micro      # RDS-klass
DB_LAGRING_GB=20          # RDS-lagring
RDS_BACKUP_DAGAR=1        # automatisk RDS-backup (Free plan: max 1)
S3_BACKUP_DAGAR=14        # livscykelregel for databasdumpar i S3
