{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListaBaraWebbmappen",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::__BUCKET__",
      "Condition": {
        "StringLike": { "s3:prefix": ["webb/*"] }
      }
    },
    {
      "Sid": "LasaOchSkrivaWebbfiler",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::__BUCKET__/webb/*"
    }
  ]
}
