{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SeInstanserIStockholm",
      "Effect": "Allow",
      "Action": ["ec2:DescribeInstances", "ec2:DescribeInstanceStatus"],
      "Resource": "*",
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "eu-north-1" }
      }
    },
    {
      "Sid": "StartaStoppaFelsokaNovatrix",
      "Effect": "Allow",
      "Action": [
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:RebootInstances",
        "ec2:GetConsoleOutput"
      ],
      "Resource": "arn:aws:ec2:eu-north-1:__KONTO__:instance/*",
      "Condition": {
        "StringEquals": { "aws:ResourceTag/Projekt": "novatrix" }
      }
    }
  ]
}
